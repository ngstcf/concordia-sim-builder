VITE_API_URL=http://localhost:8000
# Simulation timeout in milliseconds (default: 18000000 = 5 hours).
# Bounds only the timeout-warning banner and the non-streaming test
# endpoint; the streaming run path has no client-side timeout.
# For multi-day studies: 172800000 = 2 days, 345600000 = 4 days.
# JavaScript timer cap: values above 2147483647 (~24.8 days) fire instantly.
VITE_SIMULATION_TIMEOUT=18000000
