# LLM Provider Configuration
# Add your API keys for at least one provider below

# OpenAI (GPT models)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxx

# Azure OpenAI (Enterprise-grade OpenAI with data residency)
# See docs/AZURE_OPENAI_SETUP.md for detailed setup instructions
AZURE_OAI_KEY=xxx
AZURE_OAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OAI_VERSION=2024-12-01-preview

# Optional: secondary Azure OpenAI endpoint (provider id "azure2")
# Lets agents and the GM use deployments on two different Azure resources
# (e.g. a non-OpenAI model such as Kimi hosted on a second resource).
# AZURE_OAI_VERSION2 falls back to AZURE_OAI_VERSION when unset.
# AZURE_OAI_KEY2=xxx
# AZURE_OAI_ENDPOINT2=https://your-second-resource.openai.azure.com
# AZURE_OAI_VERSION2=2024-12-01-preview

# DeepSeek (recommended for cost/quality - 10-50× cheaper than GPT-4)
# Get your key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxx

# Google Gemini
# Get your key from: https://ai.google.dev/api
GEMINI_API_KEY=xxx

# Anthropic Claude
# Get your key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-xxx

# Ollama (Local Models)
# No API key required for local Ollama - Ollama runs locally on your machine
# Install from: https://ollama.com
# Default endpoint: http://localhost:11434/v1
#
# For hosted Ollama services (like OpenWebUI), you may need an API key:
# OLLAMA_API_KEY=your-optional-api-key
# OLLAMA_BASE_URL=http://localhost:11434/v1  # Or your hosted Ollama URL

# ==============================================================================
# TIMEOUT CONFIGURATION
# ==============================================================================
# These settings control how long the system waits for LLM responses before
# flagging an error. The system waits the FULL timeout duration before
# flagging an error - it does NOT prematurely interrupt long-running requests.
#
# Example: With LLM_TIMEOUT=180, a request that completes at 179s → SUCCESS
#                           a request that completes at 181s → RETRY
#
# If you're experiencing timeouts, increase these values. If simulations are
# hanging for too long, decrease these values to detect issues sooner.

# Per-LLM-request timeout in seconds (default: 180 = 3 minutes)
# This is the maximum time to wait for a SINGLE LLM API call to complete
# - Standard models (GPT-4, DeepSeek, Claude): typically respond in 5-60 seconds
# - Increase if using slower models or very large prompts
# - Formula: timeout × retries = max time per LLM call
# - Example: 180s timeout × 2 retries = 360s (6 minutes) max per call
LLM_TIMEOUT=180

# Per-LLM-request timeout for reasoning models in seconds (default: 300 = 5 minutes)
# Reasoning models (O1, O3, GPT-5) perform internal reasoning before responding
# These models can take 60-300 seconds depending on prompt complexity
# Only applies to models starting with: o1-, o3-, gpt-5
# If not set, falls back to LLM_TIMEOUT (or 300s default)
LLM_REASONING_TIMEOUT=300

# Maximum retry attempts for LLM requests (default: 2)
# Number of times to retry a failed LLM call before giving up
# - Retry 1: waits 3 seconds before retry
# - Retry 2: waits 6 seconds before retry
# - Total time if both retries timeout: timeout × 3 + 9s wait time
# - Example: 180s × 3 + 9s = 549s (~9 minutes) absolute worst case
LLM_MAX_RETRIES=2

# Simulation watchdog timeout in seconds (default: 600 = 10 minutes)
# Maximum time to wait without ANY step completing before warning
# - A "step" = all agents have acted once
# - With 6 agents, one step requires 6 LLM calls
# - If no step completes in this time, a warning is logged (simulation continues)
# - This does NOT kill the simulation, just logs a warning for monitoring
# - Increase if using many agents (6+) or very slow models
# - Decrease to detect hangs sooner (but may cause false warnings)
WATCHDOG_TIMEOUT_SECONDS=600

# Enable/disable watchdog monitoring (default: true)
# Set to 'false' to disable hang prevention entirely
# - Use this if watchdog warnings interfere with your simulations
# - Disabling means no hang detection will occur
# - Note: LLM_TIMEOUT and LLM_MAX_RETRIES still apply regardless of this setting
WATCHDOG_ENABLED=true

# ==============================================================================
# HUGGING FACE CONFIGURATION
# ==============================================================================
# Required for downloading embedding models (e.g. all-MiniLM-L6-v2) without
# rate-limit warnings. The model is cached locally after the first download.
# Get your token (free) from: https://huggingface.co/settings/tokens
# A "Read" role token is sufficient — no special model permissions needed.
HF_TOKEN=hf_xxx

# ==============================================================================
# FRONTEND CONFIGURATION
# ==============================================================================

# API base URL for the backend (default: http://localhost:8000)
VITE_API_URL=http://localhost:8000

# Frontend simulation timeout in milliseconds (default: 10800000 = 3 hours)
# This is how long the frontend waits for the backend to complete the simulation
# - The backend continues running even if frontend times out
# - Results are saved to logs/ directory regardless of frontend timeout
# - Increase for very long simulations (e.g., 21600000 = 6 hours)
# - Formula: steps × agents × avg_LLM_time × safety_margin
# - Example: 30 steps × 6 agents × 60s × 2 = 21600s (6 hours)
VITE_SIMULATION_TIMEOUT=10800000

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================
# Control the verbosity of backend console output

# Enable/disable DEBUG messages (default: true)
# Set to 'false' to reduce console output during simulations
DEBUG_ENABLED=true

# Enable/disable LLM-specific debug messages (default: true)
# Set to 'false' to hide [LLM] log messages (API calls, response times, errors)
LLM_LOGGING_ENABLED=true

# Max concurrent LLM requests per model instance (default: 16)
LLM_MAX_CONCURRENCY=64
