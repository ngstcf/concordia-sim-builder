# LLM Provider Configuration
# Add your API keys for at least one provider below

# OpenAI (GPT models)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxx

# DeepSeek (recommended for cost/quality)
# Get your key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxx

# Google Gemini
# Get your key from: https://ai.google.dev/api
GEMINI_API_KEY=xxx

# Anthropic Claude
# Get your key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-xxx

# Ollama (Local Models)
# No API key required for local Ollama - Ollama runs locally on your machine
# Install from: https://ollama.com
# Default endpoint: http://localhost:11434/v1
#
# For hosted Ollama services (like OpenWebUI), you may need an API key:
# OLLAMA_API_KEY=your-optional-api-key
# OLLAMA_BASE_URL=http://localhost:11434/v1  # Or your hosted Ollama URL

# Frontend Configuration
# API base URL for the backend (default: http://localhost:8000)
VITE_API_URL=http://localhost:8000

# Simulation timeout in milliseconds (default: 1800000 = 30 minutes)
# Increase this for very long simulations (e.g., 3600000 = 60 minutes)
# VITE_SIMULATION_TIMEOUT=1800000
