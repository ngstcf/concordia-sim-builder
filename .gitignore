test_glm_models_concordia.pyarxiv_paper.md
test.py
test2.py
images/
# Ignored by default: most of these are live LLM compatibility harnesses that
# reference endpoints and keys. Pure unit tests, which need neither network nor
# credentials, are whitelisted below so the behavior they pin ships with the code.
backend/tests/*
!backend/tests/test_agent_probe.py
!backend/tests/test_export_parsing.py
!backend/tests/test_grounded_variable_invariants.py
!backend/tests/test_watchdog_finalization.py
!backend/tests/test_checkpoint_sweep.py

