*.bak
requirements-dev.bak

# Analysis and reports
analyze_simulation.py
ARCHITECTURE_v1.md
reports/

# Research use cases
research-use-cases/

# Upstream Concordia clone (installed as editable dependency)
concordia-upstream/

# Local project notes (do not track)
CONCORDIA_ISSUES.md

simultech/

# Assistant memory notes that land in the working tree. These describe
# in-progress work rather than the code, so they do not belong in a public
# repository. Anchored to the root: backend packages named memory/ are tracked.
/memory/

# Structured exports pulled from the analytics dashboard for local inspection
# (browser downloads, including duplicate "(1).json" copies). Run output is
# reproducible from the logs and is not tracked.
/exportjson/
